# ──────────────────────────────────────────────────────────────
# BFM – Buy For Me | Environment Variables
# ──────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Service role key — required for catalog sync / search_cache from Node backend
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Optional: admin API is_admin() checks (falls back to VITE_SUPABASE_ANON_KEY)
# SUPABASE_ANON_KEY=your_anon_key

# ── Node Crawlee API ─────────────────────────────────────────
PORT=3001
FALLBACK_THB_TO_MMK=115

# Node API origin for production (skip Netlify proxy timeout; empty in local Vite)
# VITE_API_ORIGIN=https://bfm-fnrj.onrender.com

# Messenger / Facebook page for Buy Now & Smart Search contact (Vite build-time)
VITE_MESSENGER_PAGE_URL=https://m.me/1208338659022658
VITE_FACEBOOK_PAGE_URL=https://www.facebook.com/1208338659022658

# Optional: improve Lazada product preview fetch if bot-blocked
# LAZADA_COOKIE=   # Cookie header from lazada.co.th DevTools
# LAZADA_PROXY_URL=https://api.scraperapi.com/?api_key=YOUR_KEY&country_code=th&render=false&url={url}

# Add Link → Smart Search (RapidAPI only; UI on by default)
# Lazada: https://rapidapi.com/tmapi-tmapi-default/api/lazada-api
# VITE_PRODUCT_SEARCH_ENABLED=false   # hide Smart Search tab
# PRODUCT_SEARCH_ENABLED=false        # disable /api/lazada-search
RAPIDAPI_KEY=your_rapidapi_key
RAPIDAPI_LAZADA_HOST=lazada-api.p.rapidapi.com
# Render/API: RAPIDAPI_KEY must be set for Smart Search results to work.

# Lazada Seller In-house APP (ISV console) — shop products only, not marketplace search
# LAZADA_SELLER_APP_KEY=your_app_key
# LAZADA_SELLER_APP_SECRET=your_app_secret
# LAZADA_SELLER_CALLBACK_URL=https://buyforme.world/callback
# LAZADA_SELLER_ACCESS_TOKEN=   # from OAuth (see scripts/test-lazada-seller-products.ts)
# LAZADA_SELLER_BASE_URL=https://api.lazada.co.th/rest
# Test: npx tsx scripts/test-lazada-seller-products.ts

# Add Link → Affiliate Search (synced Open API catalog in Supabase)
VITE_AFFILIATE_SEARCH_ENABLED=true
# LAZADA_AFFILIATE_APP_KEY=your_liteapp_key
# LAZADA_AFFILIATE_APP_SECRET=your_liteapp_secret
# LAZADA_AFFILIATE_USER_TOKEN=your_user_token
# LAZADA_AFFILIATE_BASE_URL=https://api.lazada.co.th/rest
# Higher pages/categories = more Search catalog products (slower sync)
# LAZADA_FEED_SYNC_MAX_PAGES=150
# LAZADA_FEED_EXPAND_CATEGORIES=true
# LAZADA_FEED_MAX_CATEGORIES=200
# LAZADA_FEED_LIVE_SYNC_MINUTES=20
# LAZADA_AFFILIATE_MM_CAMPAIGN_IDS=
# LAZADA_AFFILIATE_DM_INVITE_IDS=

# ── Google AdSense (enable after site approval) ───────────────
# Responsive display ad shown with Lazada search results
# VITE_ADSENSE_CLIENT_ID=ca-pub-1234567890123456
# VITE_ADSENSE_SEARCH_SLOT=1234567890

# VITE_API_URL=https://api.yourdomain.com
